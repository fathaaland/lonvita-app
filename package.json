    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-query": "^5.83.0",
    "auth0": "^6.1.0",
    "bullmq": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cross-env": "^7.0.3",
    "date-fns": "^3.6.0",
    "docx": "^9.7.1",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
