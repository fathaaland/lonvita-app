# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google sign-in (Google Cloud console → APIs & Services → Credentials → OAuth client ID,
# type "Web application"). The authorised redirect URI must be exactly:
#   <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
# Leave both blank to hide the Google button and run on e-mail + password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PAYLOAD_SECRET=change-me-to-a-long-random-string
SEED_SECRET=change-me-to-a-random-secret-for-the-seed-endpoint

# Seed (src/lib/seed/run.ts). Locally the seed creates the demo logins (superadmin@lonvita.cz,
# admin@admin.cz, ucastnik@ucastnik.cz) plus demo towns/people/events. In production it creates
# none of that — the first superadmin comes only from these two values (min. 12 characters), is
# created once, and its password is never reset by the seed afterwards.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
# Set to true on a demo/staging deployment to seed the demo data and demo logins there too
# (still without the known-password superadmin).
SEED_DEMO_DATA=

# Logging (BetterStack) – Source > Data ingestion tab at betterstack.com. Leave blank to log
# to console only.
BETTERSTACK_SOURCE_TOKEN=
BETTERSTACK_INGESTING_HOST=
# A second BetterStack source just for the audit trail (sign-ins, password resets, and a copy of every
# audit-log entry) — set its retention to at least 18 months; the main source can stay short.
BETTERSTACK_AUDIT_SOURCE_TOKEN=
BETTERSTACK_AUDIT_INGESTING_HOST=

# Maps and address search. Unset = OpenStreetMap's public tile servers and Nominatim, whose usage
# policies aren't meant for heavy production traffic — point these at another provider when needed.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
NOMINATIM_BASE_URL=

# Worker data retention (src/lib/retention/policy.ts). Unset = dry run: every night the worker only logs
# what is due for removal (event "retention.finished"). Set to "enforce" once those reports look right.
DATA_RETENTION_MODE=

# Event import (docs/import-akci-z-webu.md) — the worker reads events out of obce's web pages, PDFs and
# pasted programs with Claude. Without a key only iCal feeds and schema.org pages can be imported.
# IMPORT_AI_MODEL overrides the model (default claude-haiku-5-5).
ANTHROPIC_API_KEY=
IMPORT_AI_MODEL=

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URI=postgresql://payload:payload@localhost:5432/lonvita

# Valkey / Redis
REDIS_URL=redis://localhost:6379
WORKER_QUEUE_CONCURRENCY=5

# Email (Resend) – get API key at https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@lonvita.cz
RESEND_FROM_NAME=Lonvita

# SMS (Twilio) – sent only when an event is cancelled. Account SID and auth token from
# https://console.twilio.com. Sender: a Messaging Service SID (preferred, wins when set) or
# TWILIO_FROM – a Twilio number in E.164 (+420…) or an alphanumeric sender ID like "Lonvita"
# where the destination country allows one. Leave blank to disable SMS (email/in-app still work).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
# Trial account only: Twilio rejects custom text (error 572006) and accepts just its predefined
# templates. Set to one (e.g. sms_event_notifications) to send that instead; leave blank once upgraded.
TWILIO_TRIAL_TEMPLATE=

# S3 Storage (MinIO – matches docker-compose.yml defaults)
S3_BUCKET=lonvita-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
