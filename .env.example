# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Auth0
AUTH0_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_ISSUER_BASE_URL=https://your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=change-me-to-a-long-random-string-for-signing-cookies
AUTH0_CALLBACK=/api/auth/callback
AUTH0_M2M_DOMAIN=your-tenant.eu.auth0.com
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_USER_DATABASE_CONNECTION=Username-Password-Authentication

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URI=postgresql://payload:payload@localhost:5432/lonvita

# Valkey / Redis
REDIS_URL=redis://localhost:6379
WORKER_QUEUE_CONCURRENCY=5

# Email (Resend) – get API key at https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@lonvita.cz
RESEND_FROM_NAME=Lonvita

# S3 Storage (MinIO – matches docker-compose.yml defaults)
S3_BUCKET=lonvita-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# Stripe (deferred — payments aren't wired up yet, paid-event UI stays hidden without this)
# NEXT_PUBLIC_PAYMENTS_CLIENT_TOKEN=
